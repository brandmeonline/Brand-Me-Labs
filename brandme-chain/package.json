{
  "name": "@brandme/chain",
  "version": "1.0.0",
  "description": "Brand.Me chain service \u2014 Midnight rights adapter (primary); optional Cardano anchor boundary (unverified, disabled)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && rm -rf dist/contracts dist/scripts && mkdir -p dist && cp -r contracts scripts dist/",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "compact:fetch": "bash scripts/fetch-compactc.sh",
    "compact:compile": "bash scripts/compile-contracts.sh",
    "compact:verify": "node scripts/verify-artifacts.mjs",
    "test:midnight:local": "bash scripts/test-midnight-local.sh",
    "test:midnight:network": "vitest run --config vitest.network.config.ts",
    "test:midnight:preprod": "MIDNIGHT_NETWORK=preprod vitest run --config vitest.network.config.ts",
    "midnight:local-network": "bash scripts/local-network.sh"
  },
  "keywords": [
    "brandme",
    "blockchain",
    "cardano",
    "midnight",
    "web3"
  ],
  "author": "Brand.Me, Inc.",
  "license": "PROPRIETARY",
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/platform-js": "2.2.4",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@noble/ciphers": "2.2.0",
    "@noble/hashes": "2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "rxjs": "7.8.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "22.18.8",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "^8.56.0",
    "fast-check": "4.3.0",
    "memory-level": "3.1.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "type": "module"
}
