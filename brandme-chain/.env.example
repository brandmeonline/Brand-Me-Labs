# Brand.Me chain service. No fallback/simulation flags exist.
PORT=3001
ENVIRONMENT=development          # demo | development | sandbox | production
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Midnight (primary rights network)
MIDNIGHT_NETWORK=preprod         # undeployed | preview | preprod | mainnet (mainnet: read-only in this build)
# MIDNIGHT_CONTRACT_ADDRESS=<hex address of the deployed brandme_rights contract on this network>
# MIDNIGHT_BLOCKFROST_PROJECT_ID=<mainnet only; server-side secret, never sent to browsers>
# MIDNIGHT_LOCAL_NODE_PORT=9944  # undeployed only
# MIDNIGHT_LOCAL_INDEXER_PORT=8088
