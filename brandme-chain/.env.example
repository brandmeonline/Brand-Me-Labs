# Brand.Me chain service. No fallback/simulation flags exist.
PORT=3001
ENVIRONMENT=development          # demo | development | sandbox | production
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Midnight (primary rights network)
MIDNIGHT_NETWORK=preprod         # undeployed | preview | preprod | mainnet (mainnet: read-only in this build)
# MIDNIGHT_CONTRACT_ADDRESS=<hex address of the deployed brandme_rights contract on this network>
# MIDNIGHT_BLOCKFROST_PROJECT_ID=<Preprod or Mainnet project token; server-side secret, never sent to browsers>
# MIDNIGHT_LOCAL_NODE_PORT=9944  # undeployed only
# MIDNIGHT_LOCAL_INDEXER_PORT=8088

# Optional durable operation status/reconciliation; configure all four together.
# Apply V011 first. Use the same environment and database as the member domains.
# SPANNER_PROJECT_ID=<project>
# SPANNER_INSTANCE_ID=<instance>
# SPANNER_DATABASE_ID=<database>
# CHAIN_SERVICE_TOKEN=<secret-manager credential of at least 32 characters>
# Configure the same token on the gateway; do not expose it to a browser.
