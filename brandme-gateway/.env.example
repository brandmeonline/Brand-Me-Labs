# Brand.Me Gateway - environment template (names and safe placeholders only)
# ===========================================================================
# Every name below is read by src/config/index.ts (zod schema) or
# src/middleware/identity/store.ts. dotenv loads brandme-gateway/.env
# (gitignored); empty values are treated as unset. Never commit a value:
# sandbox/production take secrets from Secret Manager, and every credential is
# listed in docs/build/security/credential-manifest.yaml.
# Not read any more and refused or ignored: JWT_SECRET, OAUTH_CLIENT_ID,
# OAUTH_CLIENT_SECRET, OAUTH_ISSUER, ENVIRONMENT (derived from BRANDME_MODE).

# Mode: demo | development | sandbox | production. Required; no default.
BRANDME_MODE=development
# Listen port. Default 3001 (the consumer app owns 3000).
PORT=3001

# Identity. 'dev' is a labelled simulated sign-in (demo/development only).
# sandbox/production require IDENTITY_PROVIDER=oidc, an https OIDC_ISSUER and an
# OIDC_AUDIENCE (src/middleware/mode.ts). These are public configuration.
IDENTITY_PROVIDER=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
# Asymmetric algorithms only in sandbox/production.
OIDC_ALGORITHMS=RS256,ES256
SESSION_TTL_HOURS=168

# Downstream services. Until a backend's URL and token are both set, its routes
# answer 503 "not configured" (src/services/rights.ts).
BRAIN_SERVICE_URL=http://localhost:8000
# Code default is http://localhost:3003; brandme-chain listens on 3001 by default.
CHAIN_SERVICE_URL=
RIGHTS_SERVICE_URL=
PRIVACY_SERVICE_URL=
# Export API root, without /exports.
PRIVACY_EXPORT_SERVICE_URL=

# Private service bearer credentials: server-side only, never NEXT_PUBLIC_ and
# never sent to a browser. Each is 32-256 characters of [A-Za-z0-9._~+/-] and
# all four must differ. sandbox/production: Secret Manager ids
# brandme-<mode>-rts-<name-in-kebab-case>.
RIGHTS_SERVICE_TOKEN=
PRIVACY_SERVICE_TOKEN=
PRIVACY_EXPORT_SERVICE_TOKEN=
CHAIN_SERVICE_TOKEN=

# Spanner identity/session store. Emulator locally; sandbox/production use the
# real instance through the workload identity (no key files), with no emulator.
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT_ID=test-project
SPANNER_INSTANCE_ID=brandme-instance
SPANNER_DATABASE_ID=brandme-db

# Legacy /scan NATS publisher (optional; the gateway boots without it).
NATS_URL=
NATS_MAX_RECONNECT_ATTEMPTS=10

DEFAULT_REGION=us-east1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Origins allowed to make cookie-authenticated state changes; https only in
# sandbox/production.
PUBLIC_ORIGINS=http://localhost:3000,http://localhost:3002

# /scan rate limit (src/routes/scan.ts).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
