{
  "$comment": "Implemented read API extensions. Status reads do not enable commands, prove funded transactions, or imply whole-account privacy coverage.",
  "RightsEntitlementRead": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "entitlement_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "asset_id": {
        "type": [
          "string",
          "null"
        ],
        "format": "uuid"
      },
      "issuer_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "epoch": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Lossless non-negative int64 decimal string."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "revoked"
        ]
      },
      "transferable": {
        "type": "boolean"
      },
      "reprintable": {
        "type": "boolean"
      },
      "last_tx_id": {
        "type": "string"
      },
      "last_block_height": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Lossless non-negative int64 decimal string."
      },
      "finalized_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "entitlement_id",
      "asset_id",
      "issuer_id",
      "epoch",
      "status",
      "transferable",
      "reprintable",
      "last_tx_id",
      "last_block_height",
      "finalized_at",
      "updated_at"
    ]
  },
