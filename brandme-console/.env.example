# Brand.Me Console - environment template (names and safe placeholders only)
# ==========================================================================
# These are the only names console code reads (lib/api.ts,
# app/proof/[scanId]/page.tsx). Every NEXT_PUBLIC_ value is compiled into the
# browser bundle at build time, so it must never hold a secret or credential.
# Server-side service tokens stay in the gateway. No NextAuth or OAuth setting
# is read by console code, so none is listed.

# Gateway API. The code default is http://localhost:3000 (the consumer app's
# port); the gateway listens on 3001.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# Legacy service URLs still referenced by lib/api.ts.
NEXT_PUBLIC_COMPLIANCE_SERVICE_URL=http://localhost:8102
NEXT_PUBLIC_KNOWLEDGE_SERVICE_URL=http://localhost:8101
NEXT_PUBLIC_CHAIN_SERVICE_URL=http://localhost:3001

# Explorer link base used on the proof page.
NEXT_PUBLIC_CARDANO_EXPLORER_URL=https://preprod.cardanoscan.io
