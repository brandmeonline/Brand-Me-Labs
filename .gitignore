# Only the tracked project settings file; any other JSON under .claude/ (keys, local state) stays ignored.
!.claude/settings.json
.claude/settings.local.json

# Public design contracts and fictional examples; no credentials or live records.
!docs/design/brandme/contracts/acceptance-catalog.json
!docs/design/brandme/contracts/contract-examples.json
!docs/design/brandme/contracts/demo-scenario.json
!docs/design/brandme/contracts/design-tokens.json
!docs/design/brandme/contracts/domain.schema.json
!docs/design/brandme/contracts/reward-rules.json

# Source-controlled JSON: package schemas/generated contracts, test fixtures, vendored schemas, build-lane
# evidence. A `*.json` blanket ignore silently dropped lane fixtures and schemas, so new files here must show
# up in `git status`.
!packages/**/*.json
!tests/fixtures/**/*.json
!brandme_core/**/schemas/**/*.json
!brandme_core/domains/commerce/ap2_schemas/**/*.json
!docs/build/**/*.json
!docs/build/**/*.log

# Credential-shaped JSON (NEVER commit). Kept after every negation above so no allowlisted path re-includes them.
*-service-account.json
*service-account*.json
*-sa-key.json
*-key.json
*credentials*.json
gha-creds-*.json
*wallet*.json
client_secret*.json
*secrets*.json
*token*.json
!**/design-tokens.json

