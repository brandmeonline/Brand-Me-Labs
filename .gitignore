# ========================================
# Secrets & Environment Variables
# ========================================
.env
.env.local
.env.*.local
# Every dotenv file at any depth (.env.deploy, .env.prod, ...) except committed templates. Already-tracked
# .env.development/.env.staging/.env.production stay tracked; new ones are ignored.
.env*
!.env.example
!**/.env.example
!**/.env*.example
*.pem
*.key
*.cert
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
*mnemonic*
.deployment/
secrets/
**/secrets/
**/.env
**/.env.local

# Wallet keys (NEVER commit these)
*wallet*.key
*wallet*.json
cardano-wallet*
midnight-wallet*

