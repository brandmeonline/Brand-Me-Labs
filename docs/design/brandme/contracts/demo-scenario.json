  "journey": [
    {
      "at_seconds": 0,
      "action": "enter_as_guest",
      "expected": "No wallet, camera or contact prompt"
    },
    {
      "at_seconds": 20,
      "action": "choose_visual_preferences",
      "expected": "Deterministic profile preview with editable explanation"
    },
    {
      "at_seconds": 45,
      "action": "choose_walnut_atelier",
      "expected": "Actual room asset with accessible Simple View"
    },
    {
      "at_seconds": 75,
      "action": "save_first_look_and_profile",
      "expected": "Useful persisted guest reveal; no fake verification"
    },
    {
      "at_seconds": 100,
      "action": "create_test_account_and_migrate",
      "expected": "Single migrated profile and one 100-point setup cause"
    },
    {
      "at_seconds": 120,
      "action": "lock_expression_at_78",
      "expected": "Saved version increases; later inference cannot overwrite"
    },
    {
      "at_seconds": 150,
      "action": "add_owned_overshirt_to_rail",
      "expected": "Real persistence; 900ms success animation; one 25-point award"
    },
    {
      "at_seconds": 180,
      "action": "ask_maya_and_rowan",
      "expected": "Decision closes at server-relative +300 seconds"
    },
    {
      "at_seconds": 210,
      "action": "maya_votes_pass",
      "expected": "Pass is eligible for same 10 points as yes; no duplicate award"
    },
    {
      "at_seconds": 480,
      "action": "observe_closed_decision",
      "expected": "One closure, accurate result, safe notification"
    },
    {
      "at_seconds": 500,
      "action": "prepare_demo_purchase",
      "expected": "Exact quote and human approval surface"
    },
    {
      "at_seconds": 520,
      "action": "simulate_timeout_after_merchant_acceptance",
      "expected": "Outcome unknown then one reconciled order"
    },
    {
      "at_seconds": 600,
      "action": "try_ownership_transfer_without_verified_adapter",
      "expected": "Explicit unavailable state; no fake tx hash"
    },
    {
      "at_seconds": 650,
      "action": "export_then_revoke_share",
      "expected": "Portable own data and immediately denied shared access"
    }
  ],
