{
  "name": "brandme-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Brand.Me \u2014 Be More U. Consumer app, domain services and trust infrastructure.",
  "scripts": {
    "setup:demo": "node scripts/brandme.mjs setup --mode demo",
    "dev:demo": "node scripts/brandme.mjs dev --mode demo",
    "dev": "node scripts/brandme.mjs dev --mode development",
    "check": "node scripts/brandme.mjs check",
    "smoke": "node scripts/brandme.mjs smoke",
    "migrate": "node scripts/brandme.mjs migrate",
    "contracts:generate": "pnpm --filter @brandme/contracts generate && pnpm --filter @brandme/design-system generate",
    "contracts:check": "pnpm --filter @brandme/contracts check && pnpm --filter @brandme/design-system check",
    "test:journeys": "node scripts/brandme.mjs not-yet test:journeys W03-W11",
    "test:providers": "node scripts/brandme.mjs not-yet test:providers W06-W07",
    "test:midnight:local": "node scripts/brandme.mjs not-yet test:midnight:local W09",
    "test:midnight:preprod": "node scripts/brandme.mjs not-yet test:midnight:preprod W09",
    "assets:validate": "node scripts/brandme.mjs not-yet assets:validate W04",
    "evidence:report": "node scripts/brandme.mjs evidence",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "@midnight-ntwrk/ledger-v8": "8.1.2",
      "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
      "@midnight-ntwrk/compact-runtime": "0.16.0",
      "@midnight-ntwrk/compact-js": "2.5.1",
      "@midnight-ntwrk/platform-js": "2.2.4"
    }
  }
}
