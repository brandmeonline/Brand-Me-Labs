{
  "name": "brandme-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Brand.Me Platform - Integrity-first garment authentication",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "assets:generate": "node scripts/assets/generate.mjs",
    "assets:validate": "node scripts/assets/validate.mjs",
    "assets:review": "node scripts/assets/review.mjs"
  },
  "keywords": [
    "brandme",
    "blockchain",
    "cardano",
    "midnight",
    "garment-authentication"
  ],
  "author": "Brand.Me, Inc.",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=20.0.0 <25",
    "pnpm": "10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "packageExtensions": {
      "@react-three/fiber@9.4.0": {
        "peerDependencies": {
          "@types/react": "^19.0.0"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
