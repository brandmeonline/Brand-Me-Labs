{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand.me/schemas/commerce/domain_assertion.v1.json",
  "title": "Gateway → commerce domain assertion JWT claims (ES256, kid required)",
  "description": "Signed by brandme-gateway createHttpCommerceDomainClient; verified by ExecutorAssertionVerifier(audience='brandme:commerce-domain', allow_session=True). principal is null only on provider-webhook service calls. Never accepted on the MCP executor hop.",
  "type": "object",
  "required": ["iss", "aud", "iat", "exp", "jti", "principal"],
  "properties": {
    "iss": {"type": "string"},
    "aud": {"const": "brandme:commerce-domain"},
    "iat": {"type": "integer"},
    "exp": {"type": "integer", "description": "exp - iat <= 60"},
    "jti": {"type": "string", "minLength": 16, "description": "single use; replay rejected"},
    "principal": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "subject", "session_id", "client_id", "scopes", "assurance_level", "environment",
                       "delegation_id", "identity_provider"],
          "properties": {
            "member_id": {"type": "string", "format": "uuid"},
            "subject": {"type": "string"},
            "session_id": {"type": ["string", "null"], "description": "set only for a first-party cookie session"},
            "client_id": {"type": ["string", "null"], "description": "required when session_id is null"},
            "scopes": {"type": "array", "items": {"type": "string"}},
            "assurance_level": {"type": "string", "enum": ["simulated", "aal1", "aal2", "aal3"]},
            "environment": {"type": "string", "enum": ["demo", "development", "sandbox", "production"]},
            "delegation_id": {"type": ["string", "null"]},
            "identity_provider": {"type": "string"}
          }
        }
      ]
    }
  }
}
