# Brand.Me local configuration template: names and safe placeholders only.
# `pnpm setup:demo` copies it to .env.local (gitignored); scripts/brandme.mjs then
# loads .env.local into the local gateway, brain and test runs. Never put a real
# credential here or in .env.local. sandbox/production read secrets from Secret
# Manager; every credential name is listed in
# docs/build/security/credential-manifest.yaml (checked by
# scripts/check-credential-manifest.mjs).

# demo | development | sandbox | production. Required; there is no default.
BRANDME_MODE=development

# Port map (docs/design/brandme/06-delivery-verification.md W00)
#   consumer 3000, gateway 3001, console 3002, brain 8000, policy 8001,
#   orchestrator 8002, knowledge 8003, compliance 8004, identity 8005,
#   governance 8006, cube 8007
PORT=3001
BRAIN_SERVICE_URL=http://localhost:8000
POLICY_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
PUBLIC_ORIGINS=http://localhost:3000,http://localhost:3002

# Spanner (emulator locally; real instance in sandbox/production)
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT_ID=test-project
SPANNER_INSTANCE_ID=brandme-instance
SPANNER_DATABASE_ID=brandme-db
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_PROJECT_ID=brandme-dev

# Identity. 'dev' = labelled simulated sign-in (demo/development only).
# sandbox/production require IDENTITY_PROVIDER=oidc + issuer + audience.
# OIDC_* values are public configuration, not secrets.
IDENTITY_PROVIDER=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALGORITHMS=RS256,ES256
SESSION_TTL_HOURS=168

# Private backends: rights/privacy read API, privacy export API and the chain
# service. `pnpm dev` does not start them; until a URL and its token are both
# set the gateway answers 503 "not configured" for their routes
# (brandme-gateway/src/services/rights.ts). The lines stay commented on
# purpose: .env.local is loaded into Python services too, and some of them
# treat a set-but-empty variable differently from an unset one (for example
# os.getenv("CHAIN_SERVICE_URL", default) returns ""). When you run a backend
# yourself, uncomment its lines and use a locally generated throwaway token:
# 32-256 characters of [A-Za-z0-9._~+/-], all four tokens different.
# The gateway's CHAIN_SERVICE_URL default is http://localhost:3003 while
# brandme-chain listens on 3001 by default, so set it explicitly.
# CHAIN_SERVICE_URL=
# RIGHTS_SERVICE_URL=
# PRIVACY_SERVICE_URL=
# PRIVACY_EXPORT_SERVICE_URL=
# RIGHTS_SERVICE_TOKEN=
# PRIVACY_SERVICE_TOKEN=
# PRIVACY_EXPORT_SERVICE_TOKEN=
# CHAIN_SERVICE_TOKEN=

# Legacy /scan publisher (optional locally)
NATS_URL=

LOG_LEVEL=info
